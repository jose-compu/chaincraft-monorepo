{
  "name": "@chaincraft/core",
  "version": "1.5.0",
  "description": "A platform for decentralized protocols — wire, objects, and pedagogical consensus",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jose-compu/chaincraft-monorepo.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/jose-compu/chaincraft-monorepo#readme",
  "bugs": {
    "url": "https://github.com/jose-compu/chaincraft-monorepo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "bin": {
    "chaincraft-ts-node": "dist/node.js",
    "chaincraft-ts-bt-node": "dist/btNode.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "blockchain",
    "education",
    "prototyping",
    "distributed",
    "consensus",
    "chaincraft",
    "gossip",
    "p2p"
  ],
  "scripts": {
    "prepack": "npm run build",
    "test": "node --test test/*.test.ts",
    "features": "node src/featuresCli.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "node": "node src/node.ts",
    "bt-node": "node src/btNode.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
