              "from": "loop:alice"
            },
            {
              "data": "cd",
              "from": "loop:alice"
            }
          ],
          "b_listen": "loop:bob"
        },
        {
          "op": "recv",
          "who": "b",
          "returned": [
            {
              "data": "ab",
              "from": "loop:alice"
            },
            {
              "data": "cd",
              "from": "loop:alice"
            }
          ],
          "a_inbox": [],
          "a_listen": "loop:alice",
          "b_inbox": [],
          "b_listen": "loop:bob"
        },
