  "sequence": [
    {
      "name": "two peers exchange",
      "note": "send does not require dial; recv drains FIFO",
      "steps": [
        {
          "op": "listen",
          "who": "a",
          "addr": "loop:alice",
          "ok": true,
          "a_inbox": [],
          "a_listen": "loop:alice",
          "b_inbox": [],
          "b_listen": ""
        },
        {
          "op": "listen",
          "who": "b",
          "addr": "loop:bob",
          "ok": true,
          "a_inbox": [],
          "a_listen": "loop:alice",
          "b_inbox": [],
          "b_listen": "loop:bob"
        },
        {
          "op": "dial",
          "who": "a",
          "addr": "loop:bob",
          "ok": true,
          "a_inbox": [],
          "a_listen": "loop:alice",
          "b_inbox": [],
          "b_listen": "loop:bob"
        },
        {
          "op": "send",
          "who": "a",
          "addr": "loop:bob",
          "data": "ab",
          "ok": true,
          "a_inbox": [],
          "a_listen": "loop:alice",
          "b_inbox": [
            {
              "data": "ab",
              "from": "loop:alice"
            }
          ],
          "b_listen": "loop:bob"
        },
